# 复制为 .env.local 后填入实际值

# ─── AI 推理（OpenAI 兼容协议，多 Provider 按序回退）───
# 逗号分隔：主用第一个，调用失败自动回退下一个；只留一个也可
AI_PROVIDER=agnes,deepseek

# Agnes（国内域名 .cn；海外可改 https://apihub.agnes-ai.com/v1）
AGNES_API_KEY=your-agnes-api-key
AGNES_BASE_URL=https://apihub.agnes-ai.cn/v1
AGNES_MODEL=agnes-2.5-flash

# DeepSeek
DEEPSEEK_API_KEY=your-deepseek-api-key
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# DEEPSEEK_MODEL=deepseek-chat

# 任意 OpenAI 兼容服务（通义/智谱/MiniMax/硅基流动…）
# CUSTOM_API_KEY=your-key
# CUSTOM_BASE_URL=https://your-provider/v1
# CUSTOM_MODEL=model-name

# ─── 站点 ───
NEXT_PUBLIC_SITE_URL=http://localhost:3000
